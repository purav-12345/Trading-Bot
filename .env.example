# =====================================================================
#  Copy this file to ".env" and fill in your own values.
#  NEVER commit .env. NEVER paste these keys in chat/email/screenshots.
# =====================================================================

# ---- Trading mode -------------------------------------------------
# paper = simulated fills (SAFE, default).  live = real money via Zerodha.
TRADING_MODE=paper

# ---- Zerodha Kite Connect ----------------------------------------
# Get these from https://kite.trade/  (create an app).
# Order placement is free; data API is ~Rs.500/mo.
# A STATIC IP is required by SEBI rules for live order placement.
KITE_API_KEY=
KITE_API_SECRET=
# The access token is generated daily by the login flow (see README).
KITE_ACCESS_TOKEN=

# ---- Gemini (Google AI) ------------------------------------------
# Used ONLY for: parsing your chat instructions into config, news
# sentiment bias, and end-of-day summaries. Flash-Lite = very cheap.
# Generate at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Hard cap so you are never surprise-billed. Bot refuses extra AI calls.
GEMINI_MAX_CALLS_PER_DAY=50

# ---- Notifications (optional) ------------------------------------
# Telegram: create a bot via @BotFather, get the token; get your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (SMTP) alerts (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
